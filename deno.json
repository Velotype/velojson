{
    "name": "@velotype/velojson",
    "license": "MIT",
    "version": "0.2.0",
    "exports": {
        ".": "./src_server/velojson.ts",
        "./browser": "./src_browser/velojson.ts"
    },
    "publish": {
        "exclude": [
            "tests/",
            "dist/"
        ]
    },
    "tasks": {
        "check-baseline": "deno run --no-lock --allow-read jsr:@velotype/velobaseline@0.1.1 src_browser/",
        "test": "cd tests && deno test",
        "browser_bundle": "deno bundle --minify ./src_browser/velojson.ts --output ./dist/velojson_browser.min.js --sourcemap"
    }
}